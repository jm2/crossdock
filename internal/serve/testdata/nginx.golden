# Generated by `crossdock nginx-config`; regenerate rather than editing.
# Needs ngx_http_sub_module (sub_filter), which the Debian, Fedora, EL,
# Arch and nginx.org packages all include.

# Pages published without serve.public_url name the server with a
# placeholder. This is the address to show instead: the one the request
# came to, if its Host header is a plain host name.
map $http_host $crossdock_base_url {
    "~^(\[[0-9A-Fa-f:.]+\]|[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?)(:[0-9]{1,5})?$" "$scheme://$http_host";
    default "http://&lt;host&gt;:8080";
}

# Lines only a plain-HTTP address needs (GooGet's allowunsafeurl) sit
# between these markers. For an HTTPS request they're commented out.
map $scheme $crossdock_http_only_start {
    https "<!--";
    default "<!--crossdock:http-only-->";
}
map $scheme $crossdock_http_only_end {
    https "-->";
    default "<!--/crossdock:http-only-->";
}

server {
    listen 80;
    server_name repo.example;

    # current is a symlink swapped atomically on publish. nginx resolves
    # it on every open, so keep open_file_cache off for this server.
    root /var/lib/crossdock/repo/current;
    open_file_cache off;
    disable_symlinks off;
    # A directory's index.html (published pages) wins over the listing.
    index index.html;
    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime off;  # UTC, like crossdock serve
    sub_filter_once off;
    sub_filter "http://&lt;host&gt;:8080" $crossdock_base_url;
    sub_filter "<!--crossdock:http-only-->" $crossdock_http_only_start;
    sub_filter "<!--/crossdock:http-only-->" $crossdock_http_only_end;
    add_header X-Content-Type-Options nosniff always;

    types {
        application/gzip                         db files goo gz;
        application/json                         json;
        application/pgp-signature                sig;
        application/vnd.debian.binary-package    deb;
        application/x-apple-diskimage            dmg;
        application/x-bzip2                      bz2;
        application/x-rpm                        rpm;
        application/x-tar                        tar;
        application/x-xz                         xz;
        application/xml                          plist xml;
        application/zstd                         zst;
        image/png                                png;
        text/html                                html;
        text/plain                               asc txt;
    }
    default_type application/octet-stream;
    charset utf-8;
    charset_types text/plain application/xml application/json;

    location ~ /\. { return 404; }
    location ^~ /_crossdock/ { return 404; }

    # munki
    location ~ "(^/munki/[^/]+/(catalogs|manifests|pkgsinfo)/|^/munki/[^/]+/icons/_icon_hashes\.plist$)" {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        types { }
        default_type application/xml;
    }

    # by-hash
    location ~ "(/by-hash/|/repodata/[0-9a-f]{64}-[a-z_]+\.xml\.(gz|xz|zst)$)" {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # metadata
    location ~ "(/(InRelease|Release|Release\.gpg|Packages|Packages\.(gz|xz|bz2|zst)|Sources|Sources\.(gz|xz)|repomd\.xml|repomd\.xml\.asc|index|index\.gz|index\.html|SHA256SUMS|SHA256SUMS\.asc)|\.(db|files)|\.(db|files)\.tar\.(gz|xz|zst|bz2)|\.(db|files)\.sig|\.(db|files)\.tar\.(gz|xz|zst|bz2)\.sig|^/crossdock\.(asc|gpg))$" {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        default_type text/plain;
    }

    # package
    location ~ "\.(deb|rpm|goo|dmg|pkg\.tar|pkg\.tar\.(zst|xz|gz|bz2))(\.sig)?$" {
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        add_header Cache-Control "public, max-age=300" always;
        add_header X-Content-Type-Options nosniff always;
    }
}
